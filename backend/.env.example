# Backend Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=False
SECRET_KEY=your_secret_key_here

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=puskesbot_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# GitHub Token
GITHUB_TOKEN=your_github_token_here

# API Keys
GEMINI_API_KEY=your_gemini_api_key
FONNTE_TOKEN=your_fonnte_token

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:5173

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Optional for EmailJS strict mode
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# Contact form bot protection (Cloudflare Turnstile)
TURNSTILE_SECRET_KEY=your_turnstile_secret_here
CONTACT_CAPTCHA_ENFORCE=true
CONTACT_RATE_WINDOW_SECONDS=300
CONTACT_RATE_MAX_REQUESTS=5

# Chat quota limits
CHAT_GUEST_DAILY_LIMIT=30
CHAT_PATIENT_DAILY_LIMIT=60

# Public Contact Information (used in chatbot fallback responses)
PUSKESMAS_PHONE=
PUSKESMAS_WHATSAPP=
PUSKESMAS_EMAIL=
PUSKESMAS_ADDRESS=

# JWT / Session
JWT_SECRET_KEY=your_jwt_secret_key_here
SESSION_SECRET_KEY=your_session_secret_key_here
