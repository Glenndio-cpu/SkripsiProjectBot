# Frontend Environment Variables
# Copy this file to .env (or .env.production) and fill actual values.

# API base (must include /api)
VITE_API_URL=http://localhost:5000/api

# Base path for Vite build output (optional)
VITE_BASE_PATH=/

# Public facility information shown in UI
VITE_PUSKESMAS_NAME=
VITE_PUSKESMAS_EMAIL=
VITE_PUSKESMAS_PHONE=
VITE_PUSKESMAS_WHATSAPP=
VITE_PUSKESMAS_ADDRESS=
VITE_PUSKESMAS_OPEN_HOURS=
VITE_PUSKESMAS_WEBSITE=
VITE_CONTACT_RESPONSE_TIME=1x24 jam kerja

# Contact form bot protection (Cloudflare Turnstile)
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
